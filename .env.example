# Required Telegram bot token from BotFather
BOT_TOKEN=

# Optional: HTTP(S) proxy used by yt-dlp, e.g. http://user:pass@host:port
YT_PROXY=

# Optional: base64-encoded YouTube cookies file. Keep this ONLY in Railway Variables.
# Never commit real cookies to GitHub or send them in chat.
YOUTUBE_COOKIES_B64=

# Optional limits
MAX_TRACK_SECONDS=900
MIN_TRACK_SECONDS=60
